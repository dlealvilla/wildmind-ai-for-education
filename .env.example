# PostgreSQL (Prisma). Prefer a Neon pooled connection string.
# Optional but recommended for cold starts: &connect_timeout=15
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Gemini — used by /api/chat (server). Prefer GEMINI_API_KEY (server-only).
# Current main also accepts VITE_GEMINI_API_KEY as a fallback; do not ship a
# browser-exposed key. Prefer setting only GEMINI_API_KEY.
GEMINI_API_KEY=your_gemini_api_key_here
# VITE_GEMINI_API_KEY=  # deprecated fallback — avoid

# Auth (mock base64 tokens today). Set a long random value in production.
TOKEN_SECRET=change_me_to_a_long_random_string

# Cron: send header x-cron-secret matching this value
CRON_SECRET=change_me_cron_secret

# Vercel Blob (assessment PDF upload via @vercel/blob)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your_token_here
