# PostgreSQL (Prisma). Prefer Neon pooled connection string.
# Optional but recommended for cold starts: &connect_timeout=15
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Gemini — server-only (used by /api/chat). Do NOT use a VITE_ prefix.
GEMINI_API_KEY=your_gemini_api_key_here

# Auth (required in production; mock tokens today)
TOKEN_SECRET=change_me_to_a_long_random_string

# Cron: send header x-cron-secret matching this value
CRON_SECRET=change_me_cron_secret

# Vercel Blob (assessment PDF upload via @vercel/blob)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your_token_here

# Optional
# NODE_ENV=development
